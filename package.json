{
  "name": "dsh-cpu-temp",
  "version": "0.1.0",
  "description": "Shows CPU temperature readings from supported platform sensors or an external snapshot in the DSH composer.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh-plugin", "cpu-temperature", "windows", "linux", "macos", "thermal-zone"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
